    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
