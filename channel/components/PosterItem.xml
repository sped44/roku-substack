<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
  <interface>
    <field id="width" type="float" onChange="onWidthChange" />
    <field id="height" type="float" onChange="onHeightChange" />
    <field id="itemContent" type="node" onChange="onContentChange" />
    <field id="focusPercent" type="float" onChange="onFocusChange" />
    <field id="itemHasFocus" type="boolean" onChange="onFocusChange" />
  </interface>
  <script type="text/brightscript" uri="PosterItem.brs" />
  <children>
    <Rectangle
      id="focusRing"
      width="320"
      height="180"
      color="0xFF6719FF"
      opacity="0"
    />
    <Rectangle
      id="placeholder"
      translation="[8, 8]"
      width="304"
      height="164"
      color="0x1E2430FF"
    />
    <Poster
      id="poster"
      translation="[8, 8]"
      width="304"
      height="164"
      loadDisplayMode="scaleToZoom"
    />
    <Label
      id="title"
      translation="[8, 186]"
      width="304"
      height="36"
      font="font:SmallBoldSystemFont"
      color="0xFFFFFFFF"
      wrap="true"
      maxLines="2"
    />
  </children>
</component>
